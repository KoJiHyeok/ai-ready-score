{
  "name": "ai-ready-score",
  "version": "0.1.0",
  "description": "Score how ready a local codebase is for AI coding agents.",
  "main": "src/index.js",
  "bin": {
    "ai-ready-score": "bin/ai-ready-score.js"
  },
  "scripts": {
    "dev": "node bin/ai-ready-score.js .",
    "start": "node bin/ai-ready-score.js",
    "test": "node --test tests/*.test.js",
    "check": "npm test && node bin/ai-ready-score.js . && node bin/ai-ready-score.js . --lang ko && node bin/ai-ready-score.js . --lang en && node bin/ai-ready-score.js . --json && node bin/ai-ready-score.js . --markdown",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "ai",
    "cli",
    "codebase",
    "readiness",
    "scoring"
  ],
  "files": [
    "bin/",
    "src/",
    "docs/release-checklist.md",
    "docs/release-notes/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KoJiHyeok/ai-ready-score.git"
  },
  "bugs": {
    "url": "https://github.com/KoJiHyeok/ai-ready-score/issues"
  },
  "homepage": "https://github.com/KoJiHyeok/ai-ready-score#readme",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
